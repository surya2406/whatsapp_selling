{
  "name": "VIP customer flow",
  "trigger": { "segment": "high_value", "min_orders": 10 },
  "sentiment_gate": true,
  "steps": [
    { "step": 1, "action": "parse_conversation", "input": "normalized_events" },
    { "step": 2, "action": "check_sentiment", "input": "parser.sentiment", "on_negative": "route_to_human" },
    { "step": 3, "action": "up_sell_agent" },
    { "step": 4, "action": "cross_sell_agent", "input": "parser.mentioned_products[0].normalized_product_id" },
    { "step": 5, "action": "offer_agent", "filter": "vip_offers_only" },
    { "step": 6, "action": "send_message", "template": "vip_personalized" }
  ]
}
