{
  "name": "New customer flow",
  "trigger": { "segment": "new", "max_orders": 1 },
  "sentiment_gate": true,
  "steps": [
    { "step": 1, "action": "parse_conversation", "input": "normalized_events" },
    { "step": 2, "action": "check_sentiment", "input": "parser.sentiment", "on_negative": "send_empathy_template" },
    { "step": 3, "action": "offer_agent", "filter": "welcome_offers_only" },
    { "step": 4, "action": "send_message", "template": "new_customer_welcome" }
  ]
}
