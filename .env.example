# ─── LLM ──────────────────────────────────────────────────────────────────────
# Ollama local model via Google ADK + LiteLLM
# IMPORTANT: LiteLLM reads OLLAMA_API_BASE to route all Ollama API calls.
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=minimax/m3

# ─── Agent DB (local SQLite) ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agent.db

# ─── Meta Engine DB (MySQL/MariaDB — your existing WhatsApp automation DB) ─────
META_ENGINE_DB_URL=mysql+pymysql://user:password@localhost:3306/meta_engine_db
META_ENGINE_MESSAGES_TABLE=messages
# Column names from Meta Engine messages table
META_ENGINE_SENDER_COL=sender
META_ENGINE_RECIPIENT_COL=recipient
META_ENGINE_DIRECTION_COL=direction
META_ENGINE_MESSAGE_TYPE_COL=message_type
META_ENGINE_STATUS_COL=status
META_ENGINE_WHATSAPP_MESSAGE_ID_COL=whatsapp_message_id
META_ENGINE_JOB_ID_COL=job_id
META_ENGINE_BODY_COL=content
META_ENGINE_TIMESTAMP_COL=created_at
META_ENGINE_PROCESSED_COL=is_processed

# Meta Engine endpoint used only after a human approves a draft
META_SEND_API_URL=http://localhost:8001/api/messages/send
META_SEND_API_TOKEN=
META_SEND_TIMEOUT_SECONDS=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Agent behaviour ──────────────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=10
PROFILE_CACHE_TTL_SECONDS=3600
OFFERS_CACHE_TTL_SECONDS=1800
MAX_RECOMMENDATIONS=2
SENTIMENT_GATE_ENABLED=true
DORMANT_THRESHOLD_DAYS=60
POST_PURCHASE_FOLLOWUP_DAYS=3

# ─── A/B Testing ──────────────────────────────────────────────────────────────
AB_TESTING_ENABLED=false
AB_VARIANT_RATIO=0.5
